# Database Configuration string (Neon, AWS RDS, or local)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=Your_PostgreSQL_connection_string_here

# Email Configuration (Resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Application Settings
APP_NAME=Vigilante
APP_ENV=production

# Admin Account Setup (FIRST TIME SETUP ONLY)
# Generate password hash using: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=example@vigilante.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$your_generated_hash_here

# Security Settings
SESSION_EXPIRY_HOURS=24
OTP_EXPIRY_MINUTES=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=viglante.log
DEBUG=false





